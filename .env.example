# ──────────────────────────────────────────────────────────────────────────────
# AIComply — configuración del provider LLM
# Copie este fichero como .env y rellene los valores correspondientes
# al provider que vaya a utilizar.
#
# Si LLM_PROVIDER está vacío o no existe, la interfaz mostrará el
# selector interactivo en cada inicio.
# ──────────────────────────────────────────────────────────────────────────────

# Provider activo: anthropic | openai_compatible
# Dejar vacío para usar el selector interactivo de la UI
LLM_PROVIDER=

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── API compatible con OpenAI ─────────────────────────────────────────────────
# Funciona con: Ollama, LM Studio, vLLM, llama.cpp, Groq, Together AI,
# Mistral API, o cualquier servidor con el endpoint /v1/chat/completions.
#
# Ollama (local — máxima privacidad):
#   Arranque Ollama y configure:
#   OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#   OPENAI_COMPATIBLE_MODEL=llama3.3   (o el modelo que tenga servido)
#   OPENAI_COMPATIBLE_API_KEY=         (dejar vacío, Ollama no requiere clave)
#
# LM Studio (local):
#   OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
#   OPENAI_COMPATIBLE_MODEL=llama-3.1-8b-instruct
#
# Groq:
#   OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_COMPATIBLE_API_KEY=gsk_...
#   OPENAI_COMPATIBLE_MODEL=llama-3.1-70b-versatile
#
# Together AI:
#   OPENAI_COMPATIBLE_BASE_URL=https://api.together.xyz/v1
#   OPENAI_COMPATIBLE_API_KEY=...
#   OPENAI_COMPATIBLE_MODEL=meta-llama/Llama-3-70b-chat-hf
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
